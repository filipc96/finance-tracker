{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the Fintrax main window and splash.",
  "windows": ["main", "splash"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/fintrax-server",
          "sidecar": true,
          "args": [
            "--port",
            { "validator": "\\d+" },
            "--data-dir",
            { "validator": ".+" }
          ]
        }
      ]
    }
  ]
}
